# Application
APP_NAME="EVE Diagnostics Booking Service"
DEBUG=true

# Security
SECRET_KEY="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Database
# For docker-compose the host is "db"; for local runs use "localhost"
DATABASE_URL="postgresql+psycopg://eve:eve@localhost:5432/eve_diagnostics"

# Payment simulation
# Probability (0.0 - 1.0) that a simulated payment succeeds
PAYMENT_SUCCESS_RATE=1.0
# Shared secret used to verify webhook signatures
WEBHOOK_SECRET="webhook-shared-secret"
